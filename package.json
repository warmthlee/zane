{
  "name": "zane-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:generate": "dotnet build src-dotnet/Zane.Api/Zane.Api.csproj && npx --yes --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 openapi-typescript src/api-client/Zane.Api.json -o src/api-client/schema.ts",
    "session:save": "node scripts/session-archive.mjs",
    "session:summary": "node scripts/session-archive.mjs --summary",
    "release:check": "node scripts/release-check.mjs",
    "release:deploy": "node scripts/release-deploy.mjs",
    "release:rollback": "node scripts/release-rollback.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.2.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
